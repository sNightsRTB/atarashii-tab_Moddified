import { Snapshot } from 'valtio';

interface PersistResult<T extends object> {
    store: T;
    persist: () => Promise<void>;
    restore: () => Promise<boolean>;
    clear: () => Promise<void>;
}
/************************
 *  STORAGE STRATEGIES  *
 ************************/
type StorageResult<T, Async extends boolean> = Async extends true ? Promise<T> : T;
interface StorageStrategy<Async extends boolean = boolean> {
    readonly isAsync: Async;
    has?(key: string): StorageResult<boolean, Async>;
    get(key: string): StorageResult<string | null, Async>;
    set(key: string, value: string): StorageResult<void, Async>;
    remove(key: string): StorageResult<void, Async>;
}
/*******************************
 *  SERIALIAZATION STRATEGIES  *
 *******************************/
type SerializationResult<Async extends boolean> = Async extends true ? Promise<string> : string;
type DeserializationResult<T, Async extends boolean> = Async extends true ? Promise<T> : T;
interface SerializationStrategy<T, Async extends boolean = boolean> {
    readonly isAsync: Async;
    serialize(state: Snapshot<T>): SerializationResult<Async>;
    deserialize(data: string): DeserializationResult<T, Async>;
}
/**********************
 *  MERGE STRATEGIES  *
 **********************/
type MergeResult<T, Async extends boolean> = Async extends true ? Promise<T> : T;
interface MergeStrategy<T, Async extends boolean = boolean> {
    readonly isAsync: Async;
    merge(initialState: T, restoredState: T): MergeResult<T, Async>;
}
/************************************************
 *  TYPE MARKERS FOR SERIALIZATION AND MERGING  *
 ************************************************/
declare const TYPE_MARKER: {
    readonly Date: "__DATE__";
    readonly Map: "__MAP__";
    readonly Set: "__SET__";
    readonly Symbol: "__SYMBOL__";
    readonly Function: "__FUNCTION__";
    readonly Class: "__CLASS__";
    readonly Error: "__ERROR__";
    readonly DOMElement: "__DOM_ELEMENT__";
};
type TypeMarker = (typeof TYPE_MARKER)[keyof typeof TYPE_MARKER];
interface SerializedSpecialType {
    __type: TypeMarker;
    value: unknown;
    [key: string]: unknown;
}

export { type MergeStrategy as M, type PersistResult as P, type StorageStrategy as S, TYPE_MARKER as T, type SerializationStrategy as a, type TypeMarker as b, type SerializedSpecialType as c };
